  <script type="module">
    import { animate, stagger } from 'https://unpkg.com/animejs@4.4.1/dist/bundles/anime.esm.min.js';

    function observeAndAnimate(selector, options) {
      const elements = document.querySelectorAll(selector);
      if (!elements.length) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const targets = entry.target.matches(selector) ? [entry.target] : entry.target.querySelectorAll(selector);
            animate(targets.length ? targets : entry.target, {
              opacity: [0, 1],
              translateY: [40, 0],
              ease: 'outBack(1.2)',
              duration: 800,
              delay: targets.length > 1 ? stagger(100) : 0,
              ...options
            });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      elements.forEach(el => observer.observe(el));
    }

    // Hero elements — animate immediately
    animate('.hero h1, .hero .tagline, .hero .subhead, .hero .cta', {
      opacity: [0, 1],
      translateY: [30, 0],
      ease: 'outBack(1.2)',
      duration: 900,
      delay: stagger(120),
    });

    // Section headings
    observeAndAnimate('h2');

    // Section text
    observeAndAnimate('.section-text');

    // Benefit cards
    const benefitGrid = document.querySelector('.benefits-grid');
    if (benefitGrid) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animate('.benefit-card', {
              opacity: [0, 1],
              translateY: [40, 0],
              ease: 'outBack(1.2)',
              duration: 700,
              delay: stagger(100),
            });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      observer.observe(benefitGrid);
    }

    // Logo scroll
    observeAndAnimate('.logo-scroll');

    // Featured cards
    const featuredGrid = document.querySelector('.featured-grid');
    if (featuredGrid) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animate('.featured-card', {
              opacity: [0, 1],
              translateY: [40, 0],
              ease: 'outBack(1.2)',
              duration: 800,
              delay: stagger(150),
            });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      observer.observe(featuredGrid);
    }

    // More work sub + carousel
    observeAndAnimate('.more-work .sub');
    const carouselWrap = document.querySelector('.carousel-wrap');
    if (carouselWrap) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animate('.carousel-card', {
              opacity: [0, 1],
              translateX: [60, 0],
              ease: 'outBack(1.2)',
              duration: 700,
              delay: stagger(80),
            });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      observer.observe(carouselWrap);
    }
  </script>

